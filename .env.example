# ============================================================================
#  산복도로 골든타임 프로젝트 — 인증키 템플릿
# ============================================================================
#  사용법:  cp .env.example .env   후 필요한 값만 채우세요.
#  ※ .env 는 .gitignore 에 등록되어 커밋되지 않습니다. 절대 커밋하지 마세요.
#
#  [중요] 값에 따옴표를 쓰지 마세요.
#     KEY="값"  ❌   (일부 스크립트가 단순 파싱해 따옴표까지 값에 포함됨)
#     KEY=값     ✅
#
#  실제로 반드시 필요한 것은 DATA_GO_KR_SERVICE_KEY 하나뿐입니다.
#  나머지는 선택이며, 없어도 파이프라인이 끝까지 돕니다.
# ============================================================================


# ── [필수] 공공데이터포털 (data.go.kr) ──────────────────────────────────────
#  ★ 반드시 "일반 인증키 (Decoding)" 을 사용하세요.
#     Encoding 키를 넣으면 이중 인코딩되어 SERVICE_KEY_IS_NOT_REGISTERED 오류.
#
#  사용: code/notebooks/01_병원API_확인.ipynb  (없으면 assert 로 즉시 중단)
#        code/scripts/검증_119출동.py
#  대상: 응급의료기관 정보(15000563), 부산 119 출동정보
DATA_GO_KR_SERVICE_KEY=


# ── [선택] AED 전용 키 ──────────────────────────────────────────────────────
#  자동심장충격기 위치·운영시간(15000652).
#  ※ 비워두면 위 DATA_GO_KR_SERVICE_KEY 를 재사용합니다 (`or SERVICE_KEY`).
#     같은 계정이라도 활용신청은 데이터셋별로 따로 해야 하므로,
#     15000652 를 별도 신청했다면 그 키를 여기에 넣으세요.
#  사용: code/notebooks/01_병원API_확인.ipynb
AED_SERVICE_KEY=


# ── [선택] NAVER Cloud Platform — Maps Directions 5 ─────────────────────────
#  경사계수 실측(축 2-1)용. 실주행 소요시간으로 b_up 을 회귀 추정합니다.
#
#  발급: NCP 콘솔 → All Services → Application Services → Maps
#        → Application 등록 시 [Directions 5] 반드시 체크
#        → 발급된 Client ID / Client Secret 을 아래에 입력
#  ※ 공공데이터포털·SGIS 와는 완전히 별개 서비스입니다(계정도 별도).
#  ※ 비워두면 code/scripts/검증_네비게이션.py 만 건너뛰면 됩니다.
#     실측 결과(b_up = 0.489 s/m)가 코드에 상수로 반영되어 있어
#     나머지 파이프라인은 정상 동작합니다.
#  사용: code/scripts/검증_네비게이션.py
NCP_KEY_ID=
NCP_KEY=


# ── [현재 미사용] 통계청 SGIS Open API ──────────────────────────────────────
#  구 100m 격자 라인(code/archive_100m격자/05_위험도_계산.ipynb)에서만 사용.
#  현재 파이프라인은 집계구 실측으로 대체되어 이 키가 필요 없습니다.
#  archive 노트북을 돌려볼 때만 채우세요. (sgis.kostat.go.kr/developer)
# SGIS_CONSUMER_KEY=
# SGIS_CONSUMER_SECRET=
