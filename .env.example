# ============================================================================
#  산복도로 골든타임 프로젝트 — 인증키 템플릿
# ============================================================================
#  사용법:  cp .env.example .env   후 각 값을 채우세요.
#  ※ .env 는 .gitignore 에 등록되어 커밋되지 않습니다. 절대 커밋하지 마세요.
#
#  [중요] 값에 따옴표를 쓰지 마세요.
#    일부 스크립트가 `line.split("=", 1)[1].strip()` 로 단순 파싱하므로
#    KEY="값"  →  따옴표까지 키에 포함되어 인증 실패합니다.
#    올바른 예:  DATA_GO_KR_SERVICE_KEY=abcd1234%2Fefg
# ============================================================================


# ── 1. 공공데이터포털 (data.go.kr) ──────────────────────────────────────────
#  ★ 반드시 "일반 인증키 (Decoding)" 을 사용하세요.
#     Encoding 키를 넣으면 이중 인코딩되어 SERVICE_KEY_IS_NOT_REGISTERED 오류.
#
#  DATA_GO_KR_SERVICE_KEY — 응급의료기관 정보(15000563), 부산 119 출동정보
#    사용: code/notebooks/01_병원API_확인.ipynb, code/scripts/검증_119출동.py
DATA_GO_KR_SERVICE_KEY=

#  AED_SERVICE_KEY — 자동심장충격기(AED) 위치·운영시간 (15000652)
#    사용: code/notebooks/01_병원API_확인.ipynb
#    ※ 위 키와 동일한 계정이라도 활용신청은 데이터셋별로 따로 해야 합니다.
AED_SERVICE_KEY=


# ── 2. 통계청 SGIS Open API (sgis.kostat.go.kr/developer) ───────────────────
#  집계구 통계 조회용. 서비스 등록 후 발급되는 ID/보안Key.
#    사용: code/archive_100m격자/05_위험도_계산.ipynb
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=


# ── 3. NAVER Cloud Platform — Maps Directions 5 ─────────────────────────────
#  경사계수 실측(축 2-1) 용. 실주행 소요시간으로 b_up 회귀 추정.
#
#  발급 경로:
#    NCP 콘솔 → All Services → Application Services → Maps
#    → Application 등록 시 [Directions 5] 반드시 체크
#    → 발급된 Client ID / Client Secret 을 아래에 입력
#
#  ※ 공공데이터포털·SGIS 와는 완전히 별개 서비스입니다(계정도 별도).
#  ※ 구 naveropenapi.apigw.ntruss.com 이 아닌
#     신규 maps.apigw.ntruss.com 엔드포인트를 사용합니다.
#  ※ 이 키가 없으면 code/scripts/검증_네비게이션.py 만 건너뛰면 됩니다.
#     실측된 경사계수(b_up = 0.489 s/m)가 코드에 상수로 반영되어 있어
#     나머지 파이프라인은 정상 동작합니다.
#
#    사용: code/scripts/검증_네비게이션.py
NCP_KEY_ID=
NCP_KEY=
